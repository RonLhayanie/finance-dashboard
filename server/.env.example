PORT=3001
MASTER_KEY=   # 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PATH=./data.db
LLM_PROVIDER=   # 'anthropic' or 'gemini'
LLM_API_KEY=
LLM_MODEL=   # defaults to claude-sonnet-5 (anthropic) or gemini-flash-latest (gemini) if unset
SYNC_CRON=0 3 * * *
ENABLE_SCHEDULER=false
